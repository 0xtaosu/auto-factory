WEB_PORT=80
# Optional override. Leave empty to generate a local mode-0600 administrator secret.
INVENTORY_ADMIN_TOKEN=
# Set these to the actual public HTTPS origin/hostname before remote deployment.
INVENTORY_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
INVENTORY_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
INVENTORY_COOKIE_SECURE=false
